# Copy to .env for local development. Never commit real values.
DATABASE_URL=
# Must be exactly this name -- intelligence/llm.py reads ANTHROPIC_API_KEY
# specifically (see _client()), not a generic LLM_API_KEY.
ANTHROPIC_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
APP_BASE_URL=http://localhost:8000
# Exact browser origin allowed by credentialless CORS. No path or trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAGINATION_CURSOR_SECRET=
DOCS_ENABLED=true
LOG_LEVEL=INFO
